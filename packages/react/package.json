{
  "name": "@flowviz/react",
  "version": "0.1.1",
  "description": "React component for FlowViz flow visualization engine",
  "author": "mayankrajput",
  "license": "MIT",
  "keywords": [
    "flowviz",
    "react",
    "flow",
    "visualization",
    "canvas",
    "particles",
    "graph",
    "animation",
    "component",
    "dag",
    "data-pipeline",
    "network-topology",
    "real-time"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hackelite01/flowviz.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/hackelite01/flowviz#readme",
  "bugs": {
    "url": "https://github.com/hackelite01/flowviz/issues"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "dev": "rollup -c rollup.config.js --watch"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@flowviz/core": "^0.1.1"
  }
}
