{
  "name": "@flowviz/core",
  "version": "0.1.1",
  "description": "Headless, framework-agnostic, high-performance 2D flow visualization engine (Pure Canvas2D)",
  "author": "mayankrajput",
  "license": "MIT",
  "keywords": [
    "flow",
    "visualization",
    "canvas",
    "particles",
    "graph",
    "animation",
    "dag",
    "directed-graph",
    "data-pipeline",
    "network-topology",
    "cybersecurity",
    "headless",
    "2d",
    "real-time"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hackelite01/flowviz.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/hackelite01/flowviz#readme",
  "bugs": {
    "url": "https://github.com/hackelite01/flowviz/issues"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types":   "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "dev":   "rollup -c rollup.config.js --watch"
  },
  "dependencies": {},
  "peerDependencies": {
    "d3-force": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "d3-force": { "optional": true }
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/d3-force": "^3.0.10",
    "rollup": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
